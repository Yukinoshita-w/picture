:root {
  --bg-primary: #ffffff;
  --bg-secondary: #fafafa;
  --bg-tertiary: #f5f5f5;
  --text-primary: #0a0a0a;
  --text-secondary: #525252;
  --text-tertiary: #a3a3a3;
  --border-primary: #e5e5e5;
  --border-secondary: #d4d4d4;
  --accent-primary: #0a0a0a;
  --accent-secondary: #404040;
  --accent-hover: #171717;
  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
  --spacing-2xl: 48px;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  color: var(--text-primary);
  background: var(--bg-primary);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  margin: 0;
  color: var(--text-primary);
  background: var(--bg-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
button, input, select, textarea { font: inherit; }
button, a, select { -webkit-tap-highlight-color: transparent; }
button {
  cursor: pointer;
  border: none;
  background: none;
}
button:disabled { opacity: .5; cursor: not-allowed; }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, img:focus-visible {
  outline: 2px solid var(--accent-primary);
  outline-offset: 2px;
}
[hidden] { display: none !important; }

/* Header */
.site-header {
  width: 100%;
  height: 64px;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border-primary);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--spacing-xl);
}
.site-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text-primary);
  text-decoration: none;
  font-weight: 600;
  font-size: 15px;
  letter-spacing: -0.3px;
}
.site-logo {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-primary);
  color: white;
  border-radius: var(--radius-sm);
  font-size: 16px;
}
.site-brand-copy strong {
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.3px;
}
.site-brand-copy span {
  display: none;
}
.site-nav {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.site-nav-link {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 36px;
  padding: 0 16px;
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.15s ease;
}
.site-nav-link:hover {
  color: var(--text-primary);
  background: var(--bg-secondary);
}
.site-nav-link[aria-current="page"] {
  color: white;
  background: var(--accent-primary);
}
.header-tools {
  display: flex;
  gap: var(--spacing-sm);
}
.header-tools .tool-button {
  height: 36px;
  padding: 0 12px;
  border: 1px solid var(--border-primary);
  border-radius: var(--radius-sm);
  background: var(--bg-primary);
  color: var(--text-secondary);
  font-size: 14px;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.15s ease;
}
.header-tools .tool-button:hover {
  background: var(--bg-secondary);
  color: var(--text-primary);
  border-color: var(--border-secondary);
}
.header-tools .tool-button svg {
  width: 16px;
  height: 16px;
}
.header-tools .theme-symbol {
  font-size: 16px;
  line-height: 1;
}
/* Main Workspace */
.workspace {
  margin-top: 64px;
  min-height: calc(100vh - 64px);
  display: flex;
  flex-direction: column;
}
.gallery-row {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr;
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
  padding: var(--spacing-2xl) var(--spacing-xl);
  gap: var(--spacing-xl);
}
.gallery-panel {
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
}
.gallery-heading {
  padding-bottom: var(--spacing-lg);
  border-bottom: 1px solid var(--border-primary);
  margin-bottom: var(--spacing-xl);
}
.brand {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}
.brand-mark {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent-primary);
  color: white;
  border-radius: var(--radius-md);
  font-size: 24px;
  flex-shrink: 0;
}
.brand h1 {
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.5px;
  margin: 0 0 4px;
}
.brand p {
  font-size: 13px;
  color: var(--text-secondary);
  margin: 0;
  font-weight: 500;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}
.connection-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--text-tertiary);
  margin-top: 8px;
}
.pulse-dot {
  width: 8px;
  height: 8px;
  background: #22c55e;
  border-radius: 50%;
  animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .5; }
}
.workspace-tools {
  display: none;
}
.gallery-scroll {
  flex: 1;
  overflow-y: auto;
}
.result-area {
  min-height: 400px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-state {
  text-align: center;
  max-width: 480px;
  padding: var(--spacing-2xl);
}
.empty-icon {
  width: 80px;
  height: 80px;
  margin: 0 auto var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-secondary);
  border-radius: var(--radius-lg);
  font-size: 40px;
}
.empty-state h2 {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: -0.5px;
  margin-bottom: var(--spacing-md);
  color: var(--text-primary);
}
.empty-state p {
  font-size: 15px;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-lg);
}
.empty-caption {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-tertiary);
  text-transform: uppercase;
  letter-spacing: 1px;
}
/* Input Composer */
.composer-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-primary);
  border-top: 1px solid var(--border-primary);
  z-index: 50;
}
.composer-panel form {
  max-width: 1400px;
  margin: 0 auto;
  padding: var(--spacing-lg) var(--spacing-xl);
}
.composer-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}
.composer-title {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.composer-heading label {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.generation-mode {
  padding: 4px 8px;
  background: var(--bg-secondary);
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.counter {
  font-size: 12px;
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
}
textarea {
  display: block;
  width: 100%;
  min-height: 60px;
  max-height: 180px;
  resize: none;
  border: 1px solid var(--border-primary);
  border-radius: var(--radius-md);
  padding: 12px 16px;
  background: var(--bg-primary);
  color: var(--text-primary);
  font-size: 15px;
  line-height: 1.5;
  margin-bottom: var(--spacing-md);
  transition: border-color 0.15s ease;
}
textarea:focus {
  outline: none;
  border-color: var(--accent-primary);
}
textarea::placeholder {
  color: var(--text-tertiary);
}
.composer-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-md);
}
.controls-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
  flex: 1;
}
.control {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.control label {
  font-size: 13px;
  color: var(--text-secondary);
  font-weight: 500;
}
.control select,
.size-trigger {
  height: 36px;
  padding: 0 12px;
  border: 1px solid var(--border-primary);
  border-radius: var(--radius-sm);
  background: var(--bg-primary);
  color: var(--text-primary);
  font-size: 14px;
  cursor: pointer;
  transition: all 0.15s ease;
}
.control select:hover,
.size-trigger:hover {
  background: var(--bg-secondary);
  border-color: var(--border-secondary);
}
.size-trigger {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  min-width: 140px;
  justify-content: space-between;
}
.attach-button {
  height: 36px;
  padding: 0 12px;
  border: 1px solid var(--border-primary);
  border-radius: var(--radius-sm);
  background: var(--bg-primary);
  color: var(--text-secondary);
  font-size: 14px;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
}
.attach-button:hover {
  background: var(--bg-secondary);
  color: var(--text-primary);
}
.attach-button svg {
  width: 16px;
  height: 16px;
}
.generate-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}
.optimize-button,
.cancel-button,
.generate-button {
  height: 36px;
  padding: 0 16px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
}
.optimize-button {
  background: var(--bg-secondary);
  color: var(--text-primary);
  border: 1px solid var(--border-primary);
}
.optimize-button:hover {
  background: var(--bg-tertiary);
}
.cancel-button {
  background: transparent;
  color: #ef4444;
  border: 1px solid #fee2e2;
}
.cancel-button:hover {
  background: #fef2f2;
}
.generate-button {
  background: var(--accent-primary);
  color: white;
  border: none;
}
.generate-button:hover {
  background: var(--accent-hover);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}
.shortcut-hint {
  font-size: 12px;
  color: var(--text-tertiary);
}
.workspace-status {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: var(--spacing-sm);
  line-height: 1.5;
}
.workspace-status[data-type="error"] {
  color: #ef4444;
}
.workspace-status[data-type="success"] {
  color: #22c55e;
}
.undo-prompt {
  font-size: 12px;
  color: var(--text-tertiary);
  text-decoration: underline;
  cursor: pointer;
}
.reference-hint {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: var(--spacing-sm);
  line-height: 1.5;
}
.task-progress {
  display: flex;
  gap: var(--spacing-sm);
  align-items: center;
  margin-top: var(--spacing-sm);
  font-size: 12px;
  color: var(--text-secondary);
}
#taskElapsed {
  font-variant-numeric: tabular-nums;
  font-weight: 600;
}
.generation-requirements {
  margin-top: var(--spacing-sm);
  font-size: 12px;
  color: var(--text-secondary);
}
.generation-requirements summary {
  cursor: pointer;
  color: var(--text-primary);
  font-weight: 500;
}
.generation-requirements p {
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm);
  background: var(--bg-secondary);
  border-radius: var(--radius-sm);
  max-height: 120px;
  overflow-y: auto;
  white-space: pre-wrap;
}
/* Result Grid */
.result-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
  gap: var(--spacing-xl);
  margin-bottom: var(--spacing-2xl);
}
.result-card {
  background: var(--bg-primary);
  border: 1px solid var(--border-primary);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: all 0.2s ease;
}
.result-card:hover {
  border-color: var(--border-secondary);
  box-shadow: var(--shadow-lg);
  transform: translateY(-2px);
}
.result-card img {
  display: block;
  width: 100%;
  height: 320px;
  object-fit: contain;
  background: var(--bg-secondary);
  cursor: zoom-in;
}
.result-actions {
  padding: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
  border-top: 1px solid var(--border-primary);
}
.result-actions span {
  font-size: 11px;
  color: var(--text-tertiary);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.result-prompt-actions {
  display: flex;
  gap: var(--spacing-sm);
}
.download-link {
  font-size: 14px;
  color: var(--text-primary);
  font-weight: 500;
  text-decoration: none;
  transition: color 0.15s ease;
}
.download-link:hover {
  color: var(--accent-secondary);
}
.revised-prompt {
  padding: 0 var(--spacing-md) var(--spacing-md);
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-secondary);
  overflow-wrap: anywhere;
}

/* History Section */
.history-section {
  border-top: 1px solid var(--border-primary);
  padding-top: var(--spacing-xl);
  margin-top: var(--spacing-2xl);
}
.history-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}
.history-heading h2 {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.3px;
  margin: 0;
}
.text-button {
  font-size: 14px;
  color: var(--text-secondary);
  font-weight: 500;
  text-decoration: none;
  cursor: pointer;
  transition: color 0.15s ease;
}
.text-button:hover {
  color: var(--text-primary);
}
.history-note {
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-secondary);
  margin-bottom: var(--spacing-lg);
}
.history-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
  gap: var(--spacing-lg);
}
.history-card {
  background: var(--bg-primary);
  border: 1px solid var(--border-primary);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: all 0.2s ease;
}
.history-card:hover {
  border-color: var(--border-secondary);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.history-card img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: contain;
  background: var(--bg-secondary);
  cursor: zoom-in;
}
.history-card small {
  display: block;
  padding: var(--spacing-sm) var(--spacing-md) 0;
  font-size: 12px;
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.history-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-sm) var(--spacing-md) var(--spacing-md);
  gap: var(--spacing-sm);
}
.history-actions button {
  font-size: 13px;
  color: var(--text-primary);
  font-weight: 500;
  cursor: pointer;
  transition: color 0.15s ease;
}
.history-actions button:hover {
  color: var(--accent-secondary);
}
.history-image-actions {
  display: flex;
  gap: var(--spacing-md);
}
.history-status {
  font-size: 12px;
  color: var(--text-secondary);
  margin-top: var(--spacing-md);
}
.history-status[data-type="error"] {
  color: #ef4444;
}
.storage-notice {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.5;
}
dialog { border: 1px solid var(--line); border-radius: 18px; background: var(--card); color: var(--ink); box-shadow: 0 30px 100px rgba(20,14,40,.2); max-height: calc(100dvh - 40px); }
dialog::backdrop { background: rgba(29, 22, 47, .4); backdrop-filter: blur(5px); }
.size-dialog { width: 440px; max-width: calc(100vw - 24px); padding: 20px; border-radius: 18px; overflow-y: auto; }
.size-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.size-heading h2 { margin: 0 0 5px; font-size: 16px; font-weight: 650; }
.size-heading p { margin: 0; color: var(--muted); font-size: 12px; }
.size-close { display: grid; place-items: center; width: 24px; height: 24px; border: 0; background: transparent; color: var(--muted); font-size: 23px; line-height: 1; }
.size-option { min-height: 38px; padding: 8px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); color: var(--ink); font-size: 13px; }
.size-option:hover:not(:disabled) { border-color: var(--purple); background: var(--soft); }
.size-option[aria-pressed=true] { border-color: var(--purple); background: var(--soft); color: var(--purple); }
.size-default { width: 100%; margin-bottom: 12px; }
.size-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 4px; gap: 4px; margin-bottom: 22px; border-radius: 12px; background: var(--input); }
.size-tabs button { min-height: 32px; padding: 6px 4px; border: 0; border-radius: 8px; background: transparent; color: var(--muted); font-size: 13px; }
.size-tabs button[aria-pressed=true] { background: var(--card); color: var(--ink); box-shadow: 0 1px 3px rgba(0, 0, 0, .07); }
.size-label { margin: 18px 0 8px; color: var(--muted); font-size: 12px; }
.size-resolutions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.size-ratios { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-bottom: 8px; }
.size-ratios .size-option { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 64px; font-size: 12px; }
.ratio-icon { display: block; border: 1px solid currentColor; border-radius: 3px; opacity: .7; }
.size-inputs { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: end; gap: 10px; }
.size-inputs label { display: grid; gap: 7px; color: var(--muted); font-size: 12px; }
.size-inputs > span { align-self: end; line-height: 38px; color: var(--muted); }
.size-inputs input { min-width: 0; width: 100%; height: 38px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--input); color: var(--ink); }
.size-hint { margin: 12px 0; color: var(--muted); font-size: 11px; line-height: 1.7; }
.size-supported { display: flex; flex-wrap: wrap; gap: 6px; }
.size-supported .size-option { min-height: 30px; padding: 6px 9px; font-size: 11px; border-radius: 8px; }
.size-error { margin: 12px 0 0; color: #b94752; font-size: 12px; line-height: 1.7; }
.size-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
.size-footer .primary { margin-left: 0; }
.custom-size-capability { display: flex; align-items: center; gap: 7px; font-size: 11px; color: var(--ink); }
.custom-size-capability input { accent-color: var(--purple); }
.delete-history-dialog { width: 384px; max-width: calc(100vw - 32px); padding: 24px; border: 1px solid var(--line); border-radius: 24px; box-shadow: 0 20px 60px rgba(0, 0, 0, .16); }
.delete-history-dialog::backdrop { background: rgba(0, 0, 0, .22); backdrop-filter: blur(7px); }
.delete-history-dialog h2 { margin: 0 0 8px; font-size: 16px; line-height: 1.5; font-weight: 650; }
.delete-history-dialog p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.8; }
.delete-history-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 24px; }
.delete-history-actions button { min-height: 38px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--ink); font-size: 13px; }
.delete-history-actions button:hover { background: var(--soft); }
.delete-history-actions .confirm-delete { border-color: #f43f43; background: #f43f43; color: #fff; font-weight: 600; }
.delete-history-actions .confirm-delete:hover { border-color: #df3036; background: #df3036; }
.settings-dialog { width: 480px; max-width: calc(100vw - 32px); padding: 27px; overflow-y: auto; }
.modal-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.section-label { font-size: 10px; letter-spacing: 2px; color: var(--muted); }
.modal-heading h2 { font-size: 23px; font-weight: 600; margin: 6px 0 0; }
.close-button { width: 32px; height: 32px; border: 0; border-radius: 8px; background: var(--soft); color: var(--muted); font-size: 23px; line-height: 1; display: grid; place-items: center; }
.panel-intro { font-size: 12px; line-height: 1.8; color: var(--muted); margin: 18px 0 22px; }
.field-label { display: block; font-size: 11px; font-weight: 600; letter-spacing: .5px; margin: 0 0 8px; }
.field-label[for=apiKey], .field-label[for=model] { margin-top: 20px; }
.required { color: #d57575; margin-left: 3px; }
.input-wrap { display: flex; height: 44px; align-items: center; border: 1px solid var(--line); border-radius: 8px; background: var(--input); }
.input-wrap:focus-within { border-color: var(--purple); }
.input-prefix { padding: 0 12px; color: var(--muted); }
.input-wrap input { width: 100%; min-width: 0; border: 0; outline: none; background: transparent; color: var(--ink); height: 100%; font-size: 12px; padding-right: 10px; }
.input-wrap input::placeholder { color: #aaa1b4; }
.reveal-key { border: 0; background: transparent; color: var(--muted); padding: 10px; }
.field-hint { font-size: 10px; color: var(--muted); line-height: 1.7; margin: 8px 0 18px; }
.quick-models { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 10px; color: var(--muted); margin: 10px 0 22px; }
.quick-models button { background: var(--input); border: 1px solid var(--line); color: var(--muted); font-size: 10px; border-radius: 5px; padding: 5px 7px; }
.preset-toolbar { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 7px; margin: 0 0 8px; }
.preset-toolbar input { grid-column: 1 / 3; grid-row: 2; }
.preset-toolbar #deleteImagePreset, .preset-toolbar #deleteOptimizerPreset { grid-column: 3; grid-row: 2; }
.preset-toolbar label { color: var(--muted); font-size: 11px; white-space: nowrap; }
.preset-toolbar select, .preset-toolbar input { width: 100%; min-width: 0; height: 34px; padding: 0 8px; border: 1px solid var(--line); border-radius: 7px; background: var(--input); color: var(--ink); font-size: 11px; }
.preset-toolbar input::placeholder { color: #aaa1b4; }
.preset-toolbar .button { height: 34px; padding: 0 9px; font-size: 11px; }
.preset-hint { margin-top: 0; }
.select-wrap { position: relative; }
.select-wrap select { appearance: none; width: 100%; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: var(--input); color: var(--ink); padding: 0 30px 0 12px; font-size: 12px; }
.select-wrap>span { position: absolute; top: 9px; right: 12px; color: var(--muted); pointer-events: none; }
.form-divider { height: 1px; background: var(--line); margin-bottom: 18px; }
.capability-fields { padding: 12px; border: 1px solid var(--line); border-radius: 8px; margin: 0 0 16px; min-width: 0; }
.capability-fields legend { font-size: 11px; color: var(--muted); }
.capability-options { border: 0; padding: 6px 0 12px; margin: 0; min-width: 0; }
.capability-choices { display: flex; flex-wrap: wrap; gap: 8px 12px; }
.capability-choices label { display: flex; align-items: center; gap: 4px; font-size: 11px; }
.capability-choices input { accent-color: var(--purple); }
.capability-limits { display: grid; gap: 10px; }
.capability-limits label { display: flex; flex-direction: column; gap: 6px; color: var(--muted); font-size: 11px; }
.capability-limits select { width: 100%; min-width: 0; padding: 8px; background: var(--input); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; font-size: 11px; }
.settings-actions { display: flex; align-items: center; gap: 14px; }
.button { border-radius: 8px; height: 38px; padding: 0 12px; font-size: 12px; }
.secondary { background: var(--soft); border: 1px solid var(--line); color: var(--purple); }
.primary { background: var(--purple); color: white; border: 0; margin-left: auto; }
.status-box { display: flex; align-items: flex-start; gap: 8px; background: var(--input); border-radius: 8px; padding: 12px; margin-top: 18px; font-size: 11px; line-height: 1.7; color: var(--muted); overflow-wrap: anywhere; }
.status-icon { flex-shrink: 0; width: 14px; height: 14px; margin-top: 2px; border-radius: 50%; border: 1px solid currentColor; display: grid; place-items: center; font-size: 9px; }
.status-box[data-type=error] { color: #b94752; }
.status-box[data-type=success] { color: #398155; }
.preview-dialog { max-width: min(90vw, 1100px); padding: 26px; }
.optimization-dialog { width: min(780px, calc(100vw - 32px)); padding: 27px; }
.prompt-comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.prompt-column { display: flex; flex-direction: column; gap: 8px; min-width: 0; color: var(--muted); font-size: 11px; font-weight: 600; }
.prompt-column textarea { width: 100%; height: 190px; resize: vertical; padding: 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--input); color: var(--ink); font-size: 12px; line-height: 1.7; }
.prompt-column textarea:focus { outline: 2px solid var(--purple); outline-offset: 1px; }
.prompt-column textarea[readonly] { opacity: .78; }
.optimization-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }
.preview-dialog img { display: block; max-width: 100%; max-height: 73vh; object-fit: contain; margin: auto; }
.preview-dialog p { font-size: 12px; line-height: 1.7; white-space: pre-wrap; max-width: 900px; max-height: 70px; overflow: auto; margin: 14px 0 0; }
.preview-close { position: absolute; top: 7px; right: 7px; }
.image-load-error { opacity: .4; }
.spin { animation: rotate 3s linear infinite; }
.dark-theme { --paper: #18161f; --card: #23202c; --ink: #eeeaf7; --muted: #aba2bb; --line: #3c3549; --purple: #a38bf6; --soft: #2d273c; --input: #272230; --shadow: 0 8px 32px rgba(0,0,0,.06); color-scheme: dark; }
.dark-theme .generate-button, .dark-theme .primary { color: #211832; }
.dark-theme .workspace-status[data-type=error], .dark-theme .status-box[data-type=error] { color: #f0a9b6; }
.dark-theme .workspace-status[data-type=success], .dark-theme .status-box[data-type=success] { color: #95cda8; }
@keyframes rotate { to { transform: rotate(360deg); } }
.templates-page { min-height: 100vh; min-height: 100dvh; padding: 28px; background: var(--paper); }
.templates-shell { max-width: 1440px; margin: 0 auto; }
.templates-header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 8px 0 26px; }
.templates-heading { display: flex; align-items: center; gap: 16px; }
.templates-heading h1 { margin: 6px 0 5px; font-size: clamp(24px, 3vw, 34px); font-weight: 650; letter-spacing: 0; }
.templates-heading p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }
.back-button { width: 42px; height: 42px; flex: 0 0 42px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 11px; background: var(--card); color: var(--muted); }
.back-button:hover { color: var(--purple); background: var(--soft); }
.back-button svg { width: 21px; height: 21px; }
.templates-count { color: var(--muted); font-size: 11px; white-space: nowrap; }
.templates-toolbar { display: flex; align-items: center; gap: 14px; padding: 15px; border: 1px solid var(--line); border-radius: 13px; background: var(--card); box-shadow: var(--shadow); margin-bottom: 22px; }
.template-search { height: 40px; min-width: min(360px, 100%); flex: 1; display: flex; align-items: center; gap: 9px; padding: 0 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--input); color: var(--muted); }
.template-search:focus-within { border-color: var(--purple); }
.template-search svg { width: 17px; height: 17px; flex: 0 0 auto; }
.template-search input { width: 100%; min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: 12px; }
.template-search input::placeholder { color: #aaa1b4; }
.template-filters { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: thin; }
.template-filter { height: 34px; padding: 0 12px; border: 1px solid var(--line); border-radius: 7px; background: var(--input); color: var(--muted); font-size: 11px; white-space: nowrap; }
.template-filter:hover, .template-filter[aria-selected=true] { border-color: var(--purple); background: var(--soft); color: var(--purple); }
.template-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
.template-card { min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 13px; background: var(--card); box-shadow: var(--shadow); }
.template-image-wrap { position: relative; display: block; width: 100%; padding: 0; border: 0; aspect-ratio: 4 / 3; overflow: hidden; background: linear-gradient(145deg, var(--template-accent, var(--soft)), var(--soft) 82%); text-align: left; cursor: zoom-in; }
.template-image-wrap img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
.template-card:hover .template-image-wrap img { transform: scale(1.035); }
.template-image-wrap img.image-load-error { opacity: 0; }
.template-image-wrap::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, transparent 58%, rgba(20,14,40,.28)); }
.template-card-category { display: inline-flex; color: var(--purple); background: var(--soft); border-radius: 5px; padding: 4px 7px; font-size: 10px; line-height: 1; }
.template-image-wrap .template-card-category { position: absolute; z-index: 1; left: 11px; bottom: 10px; }
.template-card-body { padding: 14px 14px 12px; }
.template-card-body h2 { margin: 9px 0 6px; font-size: 15px; font-weight: 600; }
.template-card-body > p { min-height: 38px; margin: 0; color: var(--muted); font-size: 11px; line-height: 1.65; }
.template-card-actions { display: flex; align-items: center; gap: 12px; margin-top: 14px; }
.template-card-actions button { border: 0; background: transparent; color: var(--purple); padding: 0; font-size: 11px; }
.template-card-actions button:hover { text-decoration: underline; }
.template-card-actions .template-use { margin-left: auto; height: 31px; padding: 0 10px; border-radius: 7px; background: var(--purple); color: white; }
.template-card-actions .template-use:hover { text-decoration: none; filter: brightness(1.06); }
.template-empty { text-align: center; padding: 90px 20px; color: var(--muted); }
.template-empty-icon { width: 56px; height: 56px; display: grid; place-items: center; margin: 0 auto 16px; border-radius: 17px; background: var(--soft); color: var(--purple); font-size: 28px; }
.template-empty h2 { margin: 0 0 8px; color: var(--ink); font-size: 18px; font-weight: 600; }
.template-empty p { margin: 0; font-size: 12px; }
.template-prompt-dialog { grid-template-columns: minmax(260px, 1fr) minmax(260px, 1fr); gap: 22px; width: min(900px, calc(100vw - 32px)); padding: 23px; }
.template-prompt-dialog[open] { display: grid; }
.template-prompt-dialog > img { width: 100%; height: 100%; min-height: 280px; max-height: 62vh; object-fit: cover; border-radius: 10px; background: var(--soft); }
.template-dialog-content { align-self: center; min-width: 0; padding: 14px 6px 6px 0; }
.template-dialog-content h2 { margin: 10px 0 8px; font-size: 24px; }
.template-dialog-content > p { margin: 0 0 18px; color: var(--muted); font-size: 12px; line-height: 1.8; }
.template-prompt-box { padding: 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--input); }
.template-prompt-box > span { color: var(--muted); font-size: 10px; }
.template-prompt-box p { max-height: 180px; overflow: auto; margin: 8px 0 0; color: var(--ink); font-size: 12px; line-height: 1.8; white-space: pre-wrap; }
.template-use-button { width: 100%; margin-top: 16px; margin-left: 0; }
.route-placeholder { min-height: calc(100dvh - 72px); padding: 48px 28px; }
.route-placeholder-card { width: min(620px, 100%); margin: 8vh auto 0; padding: 48px 32px; border: 1px solid var(--line); border-radius: 18px; background: var(--card); box-shadow: var(--shadow); text-align: center; }
.route-placeholder-card h1 { margin: 10px 0 8px; font-size: 30px; }
.route-placeholder-card p { margin: 0 0 24px; color: var(--muted); font-size: 13px; }
.route-placeholder-card .button { display: inline-flex; text-decoration: none; }
@media (max-width: 1000px) {
  .shortcut-hint { display: none; }
  .workspace { padding: 0 20px 20px; }
  .site-header { width: min(100% - 40px, 1800px); grid-template-columns: auto 1fr auto; gap: 12px; }
  .site-nav-link { padding: 0 11px; }
  .control label { display: none; }
  .control-label { display: none; }
  .template-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .history-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (min-width: 641px) and (max-width: 1180px) {
  .composer-toolbar { flex-wrap: wrap; }
  .generate-actions { margin-left: auto; }
  .shortcut-hint { display: none; }
}
@media (min-width: 641px) and (max-width: 820px) {
  .history-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 640px) {
  .site-header { width: calc(100% - 24px); min-height: 62px; grid-template-columns: 1fr auto; gap: 8px; }
  .site-brand { gap: 8px; }
  .site-logo { width: 30px; height: 30px; flex-basis: 30px; border-radius: 8px; font-size: 18px; }
  .site-brand-copy strong { font-size: 13px; }
  .site-brand-copy span { display: none; }
  .site-nav { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; overflow-x: auto; width: 100%; border-radius: 9px; }
  .site-nav-link { min-height: 32px; flex: 0 0 auto; padding: 0 12px; font-size: 11px; }
  .header-tools { gap: 5px; }
  .header-tools .tool-button { width: 34px; height: 34px; padding: 0; justify-content: center; }
  .header-tools .tool-button span:last-child { display: none; }
  .workspace { height: calc(100dvh - 110px); padding: 0 12px 12px; gap: 12px; min-height: 540px; }
  .gallery-row { gap: 8px; }
  .gallery-heading { padding: 14px; }
  .brand { gap: 8px; }
  .brand h1 { font-size: 14px; }
  .brand-mark { width: 28px; height: 28px; font-size: 18px; border-radius: 8px; }
  .connection-pill { display: none; }
  .gallery-scroll { padding: 14px; }
  .empty-state { padding: 28px 0; }
  .empty-icon { width: 52px; height: 52px; border-radius: 16px; font-size: 28px; }
  .empty-state h2, .empty-state h3 { font-size: 17px; }
  .empty-state p { font-size: 12px; }
  .empty-caption { display: none; }
  .composer-panel { padding: 14px 14px 10px; }
  textarea { height: 76px; font-size: 13px; }
  .composer-toolbar { flex-wrap: wrap; gap: 10px; }
  .controls-row { width: 100%; display: grid; grid-template-columns: auto 1.6fr 1fr .8fr; gap: 6px; }
  .strength-control { grid-column: 1 / -1; }
  .strength-control label { display: block; white-space: nowrap; }
  .strength-control select { width: auto; }
  .attach-button { padding: 0 7px; font-size: 10px; gap: 3px; }
  .attach-button svg { width: 13px; height: 13px; }
  .reference-item { flex-basis: min(280px, 82vw); }
  .control { min-width: 0; }
  .size-trigger { min-width: 0; width: 100%; gap: 5px; padding: 0 6px; font-size: 10px; }
  .size-trigger #sizeButtonLabel { overflow: hidden; text-overflow: ellipsis; }
  .control select { width: 100%; max-width: none; padding: 6px; font-size: 10px; }
  .generate-actions { width: 100%; gap: 8px; }
  .optimize-button { flex: 1; padding: 10px; font-size: 12px; }
  .cancel-button { flex: .75; padding: 10px 7px; }
  .generate-button { flex: 1.2; padding: 10px; font-size: 12px; }
  .workspace-status { font-size: 10px; }
  .history-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .history-actions { flex-wrap: wrap; }
  .settings-dialog { padding: 21px; }
  .optimization-dialog { padding: 21px; }
  .prompt-comparison { grid-template-columns: 1fr; gap: 12px; }
  .prompt-column textarea { height: 130px; }
  .settings-actions { gap: 9px; }
  .button { padding: 0 9px; font-size: 11px; }
  .history-section { padding-top: 18px; margin-top: 22px; }
  .templates-page { padding: 15px 12px 24px; }
  .templates-header { align-items: flex-start; padding: 4px 0 18px; }
  .templates-heading { align-items: flex-start; gap: 10px; }
  .templates-heading h1 { font-size: 24px; }
  .templates-heading p { font-size: 11px; }
  .templates-count { display: none; }
  .templates-toolbar { display: block; padding: 10px; margin-bottom: 16px; }
  .template-search { min-width: 0; width: 100%; }
  .template-filters { margin-top: 9px; padding-bottom: 2px; }
  .template-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
  .template-card-body { padding: 10px; }
  .template-card-body h2 { font-size: 13px; margin-top: 8px; }
  .template-card-body > p { min-height: 0; font-size: 10px; }
  .template-card-actions { gap: 7px; margin-top: 11px; }
  .template-card-actions button { font-size: 10px; }
  .template-card-actions .template-use { padding: 0 7px; font-size: 10px; }
  .template-prompt-dialog[open] { display: block; padding: 17px; }
  .template-prompt-dialog > img { height: 38vh; min-height: 180px; max-height: none; margin-bottom: 14px; }
  .template-dialog-content { padding: 0; }
  .template-dialog-content h2 { font-size: 20px; }
  .route-placeholder { min-height: calc(100dvh - 110px); padding: 24px 12px; }
  .route-placeholder-card { margin-top: 8vh; padding: 36px 20px; }
  .route-placeholder-card h1 { font-size: 24px; }
}
@media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; scroll-behavior: auto !important; } }

/* Modern creative studio visual system */
:root {
  --paper: #f8f7f4;
  --card: #ffffff;
  --ink: #1a1a1a;
  --muted: #6b6b6b;
  --line: #e5e3df;
  --purple: #6366f1;
  --soft: #f0f0ff;
  --input: #fafaf9;
  --accent: #f59e0b;
  --mint: #10b981;
  --shadow: 0 20px 60px rgba(0, 0, 0, .06);
  --radius-sm: 12px;
  --radius-md: 16px;
  --radius-lg: 24px;
}

body { background: var(--paper); }
.site-header {
  width: min(1540px, calc(100% - 64px));
  min-height: 88px;
  grid-template-columns: minmax(220px, 1fr) auto minmax(220px, 1fr);
  gap: 32px;
  background: rgba(255, 255, 255, .7);
  backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--line);
  position: sticky;
  top: 0;
  z-index: 100;
}
.site-brand { gap: 13px; }
.site-logo {
  width: 44px;
  height: 44px;
  flex-basis: 44px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--purple), var(--accent));
  color: white;
  font-size: 22px;
  box-shadow: 0 4px 12px rgba(99, 102, 241, .2);
}
.site-brand-copy { gap: 5px; }
.site-brand-copy strong {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.5px;
  background: linear-gradient(135deg, var(--purple), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.site-brand-copy span {
  color: var(--muted);
  font-size: 11px;
  letter-spacing: .5px;
  font-weight: 500;
}
.site-nav {
  gap: 8px;
  padding: 6px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--card);
  box-shadow: 0 4px 12px rgba(0, 0, 0, .04);
}
.site-nav-link {
  position: relative;
  min-height: 40px;
  padding: 0 18px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
  transition: all .2s cubic-bezier(.4, 0, .2, 1);
}
.site-nav-link:hover {
  color: var(--purple);
  background: var(--soft);
}
.site-nav-link[aria-current="page"] {
  color: white;
  background: linear-gradient(135deg, var(--purple), var(--accent));
  box-shadow: 0 4px 12px rgba(99, 102, 241, .3);
}
.site-nav-link[aria-current="page"]::after {
  display: none;
}
.header-tools { gap: 10px; }
.header-tools .tool-button {
  min-height: 40px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--card);
  color: var(--muted);
  font-weight: 500;
  transition: all .2s;
}
.header-tools .tool-button:hover {
  border-color: var(--purple);
  color: var(--purple);
  background: var(--soft);
  transform: translateY(-1px);
}

.workspace {
  height: calc(100dvh - 88px);
  min-height: 640px;
  max-width: 1680px;
  padding: 24px 48px 36px;
  gap: 20px;
}
.gallery-panel {
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--card);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.gallery-heading {
  padding: 24px 28px;
  border-bottom: 1px solid var(--line);
  background: linear-gradient(to bottom, var(--card), var(--paper));
}
.brand { gap: 14px; }
.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, var(--purple), var(--accent));
  color: white;
  font-size: 22px;
  box-shadow: 0 4px 12px rgba(99, 102, 241, .2);
}
.brand h1 {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.3px;
}
.brand p {
  font-size: 11px;
  letter-spacing: .3px;
  color: var(--muted);
  font-weight: 500;
}
.connection-pill { color: var(--muted); }
.pulse-dot {
  background: var(--mint);
  box-shadow: 0 0 0 4px rgba(16, 185, 129, .15);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .5; box-shadow: 0 0 0 6px rgba(16, 185, 129, .1); }
}
.gallery-scroll {
  padding: 28px 32px 32px;
  background: var(--card);
}
.empty-state { padding: 60px 16px; }
.empty-icon {
  width: 88px;
  height: 88px;
  border-radius: 22px;
  background: linear-gradient(135deg, var(--soft), var(--paper));
  color: var(--purple);
  font-size: 44px;
  box-shadow: 0 8px 24px rgba(99, 102, 241, .12);
}
.empty-state h2 {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -0.5px;
  margin-bottom: 16px;
}
.empty-state p {
  font-size: 14px;
  line-height: 1.7;
  color: var(--muted);
}
.empty-caption {
  color: var(--purple);
  font-size: 11px;
  letter-spacing: 2px;
  text-transform: uppercase;
  font-weight: 600;
}
.result-card {
  border-radius: var(--radius-md);
  border: 1px solid var(--line);
  background: var(--card);
  box-shadow: 0 8px 24px rgba(0, 0, 0, .06);
  transition: transform .2s, box-shadow .2s;
}
.result-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0, 0, 0, .1);
}
.result-card img {
  background: var(--paper);
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}
.result-actions {
  padding: 16px 18px;
  background: linear-gradient(to bottom, var(--card), var(--paper));
}
.result-actions span {
  color: var(--muted);
  letter-spacing: 1px;
  font-weight: 600;
  font-size: 10px;
  text-transform: uppercase;
}
.download-link, .result-prompt-actions button { color: var(--purple); font-weight: 600; }
.history-section {
  border-top: 1px solid var(--line);
  padding-top: 28px;
  margin-top: 32px;
}
.history-heading h2 {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.3px;
}
.history-note { color: var(--muted); font-size: 12px; }
.history-card {
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--card);
  transition: all .2s cubic-bezier(.4, 0, .2, 1);
  box-shadow: 0 4px 12px rgba(0, 0, 0, .04);
}
.history-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0, 0, 0, .1);
}
.history-card img {
  background: var(--paper);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}
.history-actions button { color: var(--purple); font-weight: 600; }

.composer-panel {
  padding: 24px 28px 16px;
  border: 1px solid rgba(99, 102, 241, .2);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
  color: white;
  box-shadow: 0 24px 60px rgba(99, 102, 241, .2);
  position: relative;
  overflow: hidden;
}
.composer-panel::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--purple), var(--accent));
}
.composer-heading label, .composer-panel .counter { color: white; }
.composer-panel .counter { opacity: .7; font-weight: 500; }
.generation-mode {
  background: rgba(245, 158, 11, .15);
  color: var(--accent);
  border-radius: 6px;
  padding: 4px 10px;
  font-weight: 600;
  font-size: 11px;
}
.composer-panel textarea {
  color: white;
  font-size: 15px;
  line-height: 1.6;
}
.composer-panel textarea::placeholder {
  color: rgba(255, 255, 255, .5);
}
.composer-toolbar { border-top-color: rgba(255, 255, 255, .1); }
.composer-panel .control-label,
.composer-panel .control label,
.composer-panel .shortcut-hint {
  color: rgba(255, 255, 255, .75);
}
.composer-panel .attach-button,
.composer-panel .size-trigger,
.composer-panel .control select {
  border-color: rgba(255, 255, 255, .15);
  background: rgba(255, 255, 255, .08);
  color: white;
  backdrop-filter: blur(10px);
}
.composer-panel .attach-button:hover,
.composer-panel .size-trigger:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: rgba(245, 158, 11, .15);
}
.composer-panel .optimize-button {
  border-color: rgba(255, 255, 255, .15);
  background: rgba(255, 255, 255, .08);
  color: var(--accent);
  font-weight: 600;
}
.composer-panel .optimize-button:hover {
  border-color: var(--accent);
  background: rgba(245, 158, 11, .15);
}
.composer-panel .generate-button {
  background: linear-gradient(135deg, var(--accent), #f97316);
  box-shadow: 0 8px 24px rgba(245, 158, 11, .3);
  font-weight: 700;
}
.composer-panel .generate-button:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
  box-shadow: 0 12px 32px rgba(245, 158, 11, .4);
}
.composer-panel .workspace-status { color: rgba(255, 255, 255, .7); }
.composer-panel .workspace-status[data-type="success"] { color: var(--mint); }
.composer-panel .workspace-status[data-type="error"] { color: #fca5a5; }
.composer-panel .generation-requirements { color: rgba(255, 255, 255, .75); }
.composer-panel .generation-requirements summary { color: var(--accent); }
.composer-panel .generation-requirements p {
  border-color: rgba(255, 255, 255, .1);
  background: rgba(255, 255, 255, .05);
}
.composer-panel select,
.composer-panel select option {
  color-scheme: dark;
  background-color: rgba(30, 27, 75, .9);
  color: white;
}
.composer-panel select option:checked {
  background: var(--accent);
  color: white;
}
.composer-panel .size-trigger:focus-visible,
.composer-panel select:focus-visible {
  outline-color: var(--accent);
}

.templates-page { padding: 40px 48px 56px; background: var(--paper); }
.templates-shell { max-width: 1520px; }
.templates-header { padding: 12px 0 32px; border-bottom: 1px solid var(--line); }
.templates-heading h1 {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: clamp(36px, 4.5vw, 58px);
  font-weight: 800;
  letter-spacing: -1px;
  background: linear-gradient(135deg, var(--purple), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.templates-heading p { font-size: 13px; letter-spacing: .5px; color: var(--muted); }
.templates-count {
  color: var(--purple);
  letter-spacing: 1.5px;
  font-weight: 700;
  font-size: 12px;
}
.templates-toolbar {
  margin: 28px 0;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--card);
  box-shadow: 0 4px 12px rgba(0, 0, 0, .04);
}
.template-search {
  background: var(--input);
  border-color: var(--line);
  border-radius: 10px;
  height: 44px;
}
.template-search:focus-within {
  border-color: var(--purple);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, .1);
}
.template-filter {
  border-color: var(--line);
  background: var(--card);
  border-radius: 10px;
  font-weight: 500;
  transition: all .2s;
}
.template-filter:hover,
.template-filter[aria-selected="true"] {
  border-color: var(--purple);
  background: var(--soft);
  color: var(--purple);
  transform: translateY(-1px);
}
.template-grid { gap: 24px; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); }
.template-card {
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--card);
  box-shadow: 0 8px 20px rgba(0, 0, 0, .05);
  transition: all .3s cubic-bezier(.4, 0, .2, 1);
}
.template-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, .12);
}
.template-image-wrap {
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}
.template-card-body { padding: 18px 18px 16px; }
.template-card-body h2 {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.3px;
}
.template-card-body > p { font-size: 12px; line-height: 1.7; color: var(--muted); }
.template-card-actions .template-use {
  background: linear-gradient(135deg, var(--purple), var(--accent));
  box-shadow: 0 4px 12px rgba(99, 102, 241, .25);
  border-radius: 8px;
  font-weight: 600;
}
.template-card-actions .template-use:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(99, 102, 241, .35);
}
.route-placeholder {
  min-height: calc(100dvh - 84px);
  padding: 76px 40px;
  display: grid;
  place-items: center;
}
.route-placeholder-card {
  position: relative;
  width: min(920px, 100%);
  min-height: 360px;
  margin: 0;
  padding: 76px;
  overflow: hidden;
  border: 1px solid #3d354d;
  border-radius: 24px;
  background: #282332;
  color: #fffaf3;
  box-shadow: 0 24px 60px rgba(39, 29, 47, .2);
  text-align: left;
}
.route-placeholder-card::before {
  position: absolute;
  right: 44px;
  bottom: -52px;
  color: rgba(246, 188, 121, .12);
  content: "02";
  font-family: Georgia, "Songti SC", serif;
  font-size: 240px;
  line-height: .8;
}
.route-placeholder-card::after {
  position: absolute;
  top: 38px;
  right: 76px;
  color: rgba(255, 250, 243, .46);
  content: "STORYBOARD / FUTURE WORK";
  font-size: 10px;
  letter-spacing: 2px;
}
.route-placeholder-card .section-label { color: #f6bc79; }
.route-placeholder-card h1 { position: relative; z-index: 1; margin: 22px 0 12px; color: #fffaf3; font-family: Georgia, "Songti SC", serif; font-size: clamp(38px, 5vw, 70px); font-weight: 400; }
.route-placeholder-card p { position: relative; z-index: 1; max-width: 390px; margin: 0; color: rgba(255, 250, 243, .62); font-size: 13px; line-height: 1.9; }

@media (max-width: 1000px) {
  .site-header { width: min(100% - 40px, 1540px); gap: 16px; }
  .site-nav { gap: 14px; }
  .workspace { padding: 16px 20px 22px; }
  .templates-page { padding: 28px 24px 42px; }
  .route-placeholder { padding: 52px 20px; }
}
@media (max-width: 640px) {
  .site-header { width: calc(100% - 24px); min-height: 64px; }
  .site-logo { width: 32px; height: 32px; flex-basis: 32px; font-size: 17px; }
  .site-brand-copy strong { font-size: 15px; }
  .site-nav { gap: 18px; }
  .site-nav-link { min-height: 32px; font-size: 11px; }
  .workspace { height: calc(100dvh - 112px); min-height: 540px; padding: 10px 12px 14px; gap: 12px; }
  .gallery-panel { border-radius: 17px; }
  .gallery-heading { padding: 14px 16px; }
  .gallery-scroll { padding: 16px; }
  .composer-panel { padding: 16px 15px 11px; border-radius: 16px; }
  .composer-panel textarea { font-size: 13px; }
  .templates-page { padding: 22px 14px 34px; }
  .templates-header { padding: 4px 0 20px; }
  .templates-toolbar { margin: 18px 0 18px; }
  .route-placeholder { min-height: calc(100dvh - 112px); padding: 28px 12px; }
  .route-placeholder-card { min-height: 330px; padding: 42px 28px; border-radius: 18px; }
  .route-placeholder-card::before { right: 18px; bottom: -18px; font-size: 160px; }
  .route-placeholder-card::after { top: 22px; right: 28px; font-size: 8px; }
}

/* Contrast and image density corrections */
:root {
  --purple: #6366f1;
  --soft: #f0f0ff;
  --accent: #f59e0b;
}
.dark-theme {
  --paper: #0f0f0f;
  --card: #1a1a1a;
  --ink: #ffffff;
  --muted: #a3a3a3;
  --line: #2a2a2a;
  --purple: #818cf8;
  --soft: #1e1b4b;
  --input: #171717;
  --accent: #fbbf24;
  --mint: #34d399;
  --shadow: 0 20px 60px rgba(0, 0, 0, .4);
  color-scheme: dark;
}
.dark-theme select, .dark-theme select option { color-scheme: dark; }
select, select option { color-scheme: light; }
.composer-panel { color-scheme: dark; }
.composer-panel textarea::placeholder { color: rgba(255, 250, 243, .66); }
.composer-panel .control-label, .composer-panel .control label, .composer-panel .shortcut-hint { color: rgba(255, 250, 243, .76); }
.composer-panel .workspace-status { color: rgba(255, 250, 243, .72); }
.composer-panel select, .composer-panel select option {
  color-scheme: dark;
  background-color: #302a38;
  color: #fffaf3;
}
.composer-panel select option:checked { background: #d45f4d; color: #fffaf3; }
.composer-panel .size-trigger:focus-visible, .composer-panel select:focus-visible { outline-color: var(--accent); }
.history-actions button, .download-link, .result-prompt-actions button,
.corridor-tools button, .gallery-art-actions button { color: var(--accent); }
.history-card img { object-fit: cover; }
.template-filter:hover, .template-filter[aria-selected="true"] { color: var(--accent); border-color: var(--accent); }
.template-card-actions .template-use { background: var(--accent); }
.route-placeholder-card .section-label { color: #f6bc79; }
